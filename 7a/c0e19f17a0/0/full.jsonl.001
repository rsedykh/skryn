c.width, gateSrc.height, block, gray);\n        g.fillStyle = '#fff'; g.fillRect(0, 0, gc.width, gc.height); // what a shift uncovers inverts to page color\n        g.imageSmoothingEnabled = false;\n        g.drawImage(m.canvas, shift.x * block0 * kx * shiftK, shift.y * block0 * ky * shiftK, m.nx * block * kx, m.ny * block * ky);\n      }\n\n      // The shift, in whole blocks, that leaves the gate's caption on solid page color, and if possible the note and the link too.\n      // A block this light (or no block at all) inverts to the page color or darker.\n      let shift = { x: 0, y: 0 };\n      function findShift() {\n        shift = { x: 0, y: 0 };\n        try {\n          const m = mosaic(gateSrc, 0, 0, gateSrc.width, gateSrc.height, block0);\n          const px = m.canvas.getContext('2d').getImageData(0, 0, m.nx, m.ny).data;\n          const b = gate.getBoundingClientRect(), cw = b.width * block0 / gateSrc.width, ch = b.height * block0 / gateSrc.height;\n          const light = (i, j) => i < 0 || j < 0 || i >= m.nx || j >= m.ny || px[(j * m.nx + i) * 4] >= 227;\n          const clear = (el, dx, dy) => {\n            const r = el.getBoundingClientRect(), pad = .25;\n            for (let j = Math.floor((r.top - b.top) / ch - pad); j < Math.ceil((r.bottom - b.top) / ch + pad); j++)\n              for (let i = Math.floor((r.left - b.left) / cw - pad); i < Math.ceil((r.right - b.left) / cw + pad); i++)\n                if (!light(i - dx, j - dy)) return false;\n            return true;\n          };\n          const cap = gate.querySelector('.gate-cap'), extras = [gate.querySelector('.gate-note'), gate.querySelector('.gate-watch')];\n          let best = null;\n          for (let dy = -4; dy <= 4; dy++) for (let dx = -4; dx <= 4; dx++) {\n            if (!clear(cap, dx, dy)) continue;\n            const score = extras.filter((el) => clear(el, dx, dy)).length * 100 - Math.abs(dx) - Math.abs(dy);\n            if (!best || score > best.score) best = { x: dx, y: dy, s