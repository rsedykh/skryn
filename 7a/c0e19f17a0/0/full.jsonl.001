ldStart":305,"oldLines":15,"newStart":305,"newLines":16,"lines":["       padding: 15px 28px; font: 700 18px/1 var(--sans); letter-spacing: -.01em; transition: transform .15s ease;","     }","     .gate-btns button:hover { transform: translateY(-1px); }","-    .gate-btns button:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }","+    .gate-btns button:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }","     /* the page's main-button look (like Download); red stays for the marks */","-    .gate-try { background: #1d1d1f; color: #f3f2ef; box-shadow: 0 6px 20px rgba(0, 0, 0, .18); }","+    .gate-try { background: var(--ink); color: var(--paper); box-shadow: 0 6px 20px rgba(0, 0, 0, .25); }","     .gate-btns .gate-watch {","-      padding: 6px 2px; border-radius: 4px; background: none; color: #1d1d1f;","+      padding: 6px 2px; border-radius: 4px; background: none; color: #fff;","       font-size: 16px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1.5px;","+      text-shadow: 0 1px 8px rgba(0, 0, 0, .35);","     }","     .gate-btns .gate-watch:hover { transform: none; opacity: .8; }","-    .gate-cap { max-width: 24em; text-wrap: balance; font-size: 15px; font-weight: 500; color: #3a3a3e; }","+    .gate-cap { max-width: 24em; text-wrap: balance; font-size: 15px; font-weight: 500; color: rgba(255, 255, 255, .88); text-shadow: 0 1px 8px rgba(0, 0, 0, .35); }","     .gate-note { justify-self: start; margin: 0 0 64px -110px; font-size: 24px; }","     @media (max-width: 760px) { .gate-note { margin: 0 0 48px; } }","     .gate-tag { position: absolute; z-index: 2; top: 14px; right: 14px; }"]}]}],"moreFiles":0,"changedFiles":["/Users/rsedykh/GitHub/skryn/docs/index.html"],"shared":true}},"serverClassifierContext":{"request":"1ecb8a0c-7bd6-4438-bb3f-4a7bdb85b55d","context":{"git_state":{"cwd":"/Users/rsedykh/GitHub/skryn","root":"/Users/rsedykh/GitHub/skryn","branch":"main","default_branch"