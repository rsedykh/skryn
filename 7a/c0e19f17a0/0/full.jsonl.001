{"parentUuid":"60e25830-4f6d-4446-bbea-301812b1403c","isSidechain":false,"promptId":"89b9fb50-79a7-47eb-bc68-16369334264d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FA8sBysrymNstztta2BYZ1","type":"tool_result","content":"491\t<body>\n492\t  <script>document.documentElement.classList.add('js')</script>\n493\t\n494\t  <header class=\"top\">\n495\t    <div class=\"wrap top-in\">\n496\t    <a class=\"brand\" href=\"#top\" aria-label=\"Skryn, back to top\"><img src=\"../assets/icon.svg\" alt=\"\" width=\"34\" height=\"34\">Skryn</a>\n497\t    <nav aria-label=\"Sections\">\n498\t      <a href=\"#demo\" id=\"nav-demo\">Demo</a>\n499\t      <a href=\"#tools\">Tools</a>\n500\t      <a href=\"#install\">Install</a>\n501\t      <a class=\"gh\" href=\"https://github.com/rsedykh/skryn\">GitHub</a>\n502\t      <a class=\"nav-dl\" href=\"https://github.com/rsedykh/skryn/releases/latest\">Download</a>\n503\t    </nav>\n504\t    </div>\n505\t  </header>\n506\t\n507\t  <main id=\"top\">\n508\t    <!-- HERO -->\n509\t    <section class=\"wrap hero\" aria-labelledby=\"hero-h\">\n510\t      <div data-ink>\n511\t        <h1 id=\"hero-h\">\n512\t          <span>Screenshot it.<span class=\"keys sm tag\" aria-hidden=\"true\"><kbd>⇧</kbd><kbd>⌘</kbd><kbd>5</kbd><b>capture</b></span></span>\n513\t          <span><span class=\"circled\" data-mark=\"ellipse\" data-pad=\"0.15em 0.07em\">Mark it up.</span><span class=\"keys sm tag\" aria-hidden=\"true\"><kbd>⇧</kbd><kbd>⌘</kbd><kbd>Drag</kbd><b>ellipse</b></span></span>\n514\t          <span>Send it.<span class=\"keys sm tag\" aria-hidden=\"true\"><kbd>⌘</kbd><kbd>⏎</kbd><b>copy</b></span></span>\n515\t        </h1>\n516\t        <p class=\"lede\">Skryn lives in your Mac's menu bar. Press <strong>⇧⌘5</strong>, mark up the screenshot with arrows, boxes, blur, text and numbered steps, then copy, save or upload it with one keystroke.</p>\n517\t        <div class=\"cta-row\">\n518\t          <a id=\"dl\" class=\"download\" href=\"https://github.com/rsedykh/skryn/releases/latest\" data-mark=\"rect\" data-pad=\"9 9\">\n519\t            <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 2.5v10m0 0-4-4m4 4 4-4M3.5 15.5h13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n520\t            Download for macOS\n521\t          </a>\n522\t          <div class=\"start\">\n523\t            <p class=\"note\" data-mark=\"arrow\" data-to=\"#dl\" data-gap=\"20\">Start here</p>\n524\t            <span class=\"keys sm legend\" aria-hidden=\"true\"><span><kbd>T</kbd></span><b>text</b><span><kbd>Drag</kbd></span><b>arrow</b><span><kbd>⌘</kbd><kbd>Drag</kbd></span><b>rectangle</b></span>\n525\t          </div>\n526\t          <p class=\"cta-meta\">macOS 14 or later · <a href=\"https://github.com/rsedykh/skryn\">Source on GitHub</a></p>\n527\t        </div>\n528\t      </div>\n529\t    </section>\n530\t\n531\t    <!-- DEMO: live playground on a laptop, the video on phones (and for no-JS) -->\n532\t    <section class=\"stage\" id=\"demo\" aria-label=\"Demo\">\n533\t      <div class=\"stage-cap above\">\n534\t        <span class=\"keys v-only\" aria-hidden=\"true\"><kbd>⌥</kbd><kbd>Drag</kbd><b>crop</b></span>\n535\t      </div>\n536\t      <div class=\"crop-frame\">\n537\t        <video controls playsinline preload=\"none\" poster=\"../assets/poster.webp\" aria-label=\"Skryn demo video: capture, annotate, crop and paste\">\n538\t          <source src=\"https://github.com/user-attachments/assets/fad9d1f0-c079-474f-95c9-f9be2e1e02a7\" type=\"video/mp4\">\n539\t          <a href=\"https://github.com/user-attachments/assets/fad9d1f0-c079-474f-95c9-f9be2e1e02a7\">Watch the demo video</a>\n540\t        </video>\n541\t        <button class=\"play\" type=\"button\" aria-label=\"Play the demo video\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5.2v13.6a1 1 0 0 0 1.5.86l11-6.8a1 1 0 0 0 0-1.72l-11-6.8A1 1 0 0 0 8 5.2Z\" fill=\"currentColor\"/></svg></span></button>\n542\t        <div class=\"pg-win\" id=\"pg\" tabindex=\"0\" role=\"application\" aria-roledescription=\"annotation playground\" inert\n543\t             aria-label=\"Annotation playground. Drag to draw an arrow. Hold Shift for a line, Command for a rectangle, Shift and Command for an ellipse, Control for blur, Option for crop. Digits place badges, T types text, C switches color.\">\n544\t          <img data-src=\"../assets/shot.webp\" width=\"872\" height=\"543\" alt=\"Sample screenshot: the API keys page of a fictional Example Cloud console, with a production key, a test key and a revoked key.\" draggable=\"false\">\n545\t          <canvas aria-hidden=\"true\"></canvas>\n546\t          <div class=\"pg-toast\" role=\"status\" aria-live=\"polite\"></div>\n547\t        </div>\n548\t        <div class=\"gate\">\n549\t          <canvas aria-hidden=\"true\"></canvas>\n550\t          <div class=\"gate-ui\">\n551\t            <div class=\"gate-btns\">\n552\t              <button type=\"button\" class=\"gate-try\">Try it</button>\n553\t              <button type=\"button\" class=\"gate-watch\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5.2v13.6a1 1 0 0 0 1.5.86l11-6.8a1 1 0 0 0 0-1.72l-11-6.8A1 1 0 0 0 8 5.2Z\" fill=\"currentColor\"/></svg>Watch the video</button>\n554\t            </div>\n555\t            <p>A browser replica of Skryn's annotation window. Same keys as the app.</p>\n556\t          </div>\n557\t          <span class=\"keys sm gate-tag\" aria-hidden=\"true\"><kbd>⌃</kbd><kbd>Drag</kbd><b>blur</b></span>\n558\t        </div>\n559\t        <i class=\"h tl\"></i><i class=\"h tr\"></i><i class=\"h bl\"></i><i class=\"h br\"></i>\n560\t      </div>\n561\t      <div class=\"pg-bar\" id=\"pg-bar\" role=\"toolbar\" aria-label=\"Playground tools\">\n562\t        <button class=\"tb\" type=\"button\" data-tool=\"arrow\" aria-pressed=\"false\"><kbd>Drag</kbd>Arrow</button>\n563\t        <button class=\"tb\" type=\"button\" data-tool=\"line\" aria-pressed=\"false\"><kbd>⇧</kbd>Line</button>\n564\t        <button class=\"tb\" type=\"button\" data-tool=\"rect\" aria-pressed=\"false\"><kbd>⌘</kbd>Rect</button>\n565\t        <button class=\"tb\" type=\"button\" data-tool=\"ellipse\" aria-pressed=\"false\"><kbd>⇧⌘</kbd>Ellipse</button>\n566\t        <button class=\"tb\" type=\"button\" data-tool=\"blur\" aria-pressed=\"false\"><kbd>⌃</kbd>Blur</button>\n567\t        <button class=\"tb\" type=\"button\" data-tool=\"crop\" aria-pressed=\"false\"><kbd>⌥</kbd>Crop</button>\n568\t        <button class=\"tb\" type=\"button\" data-tool=\"badge\" aria-pressed=\"false\"><kbd>1–0</kbd>Badge</button>\n569\t        <button class=\"tb\" type=\"button\" data-tool=\"text\" aria-pressed=\"false\"><kbd>T</kbd>Text</button>\n570\t        <span class=\"pg-sep\" aria-hidden=\"true\"></span>\n571\t        <button class=\"tb\" type=\"button\" data-act=\"color\" aria-label=\"Switch color (C)\"><kbd>C</kbd><span><i class=\"dot\" aria-hidden=\"true\"></i><span class=\"cname\">Red</span></span></button>\n572\t        <button class=\"tb\" type=\"button\" data-act=\"undo\" aria-label=\"Undo (Command Z)\"><kbd>⌘Z</kbd>Undo</button>\n573\t        <button class=\"tb\" type=\"button\" data-act=\"redo\" aria-label=\"Redo (Shift Command Z)\"><kbd>⇧⌘Z</kbd>Redo</button>\n574\t        <button class=\"tb\" type=\"button\" data-act=\"reset\" aria-label=\"Clear all marks\"><kbd>↺</kbd>Clear</button>\n575\t        <span class=\"pg-sep\" aria-hidden=\"true\"></span>\n576\t        <button class=\"tb\" type=\"button\" data-act=\"copy\" aria-label=\"Copy to clipboard (Command Return)\"><kbd>⌘⏎</kbd>Copy</button>\n577\t        <button class=\"tb\" type=\"button\" data-act=\"save\" aria-label=\"Save PNG (Option Return)\"><kbd>⌥⏎</kbd>Save</button>\n578\t        <button class=\"tb\" type=\"button\" data-act=\"upload\" aria-label=\"Upload (Control Return)\"><kbd>⌃⏎</kbd>Upload</button>\n579\t      </div>\n580\t      <div class=\"stage-cap below\">\n581\t        <span class=\"keys v-only\" aria-hidden=\"true\"><kbd>Esc</kbd><b>remove crop</b></span>\n582\t        <button type=\"button\" class=\"switch\"></button>\n583\t      </div>\n584\t    </section>\n585\t\n586\t\n587\t    <!-- TOOLS -->\n588\t    <section id=\"tools\" class=\"wrap sec\" aria-labelledby=\"tools-h\">\n589\t      <div class=\"sec-head\">\n590\t        <h2 id=\"tools-h\">Hold a key. Pick a tool.</h2>\n591\t        <p>Each tool below is marked up with itself. The modifier you hold when you start dragging decides what you draw.</p>\n592\t      </div>\n593\t      <div class=\"tools\">\n594\t        <article class=\"tool\">\n595\t          <div class=\"spec arrow\" data-ink>\n596\t            <h3 class=\"w\" id=\"w-arrow\">Arrow</h3>\n597\t            <i class=\"tail\" data-mark=\"arrow\" data-to=\"#w-arrow\" data-gap=\"10\"></i>\n598\t          </div>\n599\t          <div class=\"tool-foot\"><p>Point at the thing. No modifier needed.</p><span class=\"keys\"><kbd>Drag</kbd></span></div>\n600\t        </article>\n601\t        <article class=\"tool\">\n602\t          <div class=\"spec\" data-ink><h3 class=\"w\" data-mark=\"line\" data-off=\"6\">Line</h3></div>\n603\t          <div class=\"tool-foot\"><p>Underline a warning, strike a path.</p><span class=\"keys\"><kbd>⇧</kbd><kbd>Drag</kbd></span></div>\n604\t        </article>\n605\t        <article class=\"tool\">\n606\t          <div class=\"spec\" data-ink><h3 class=\"w\" data-mark=\"rect\" data-pad=\"0.2em 0.22em\">Rectangle</h3></div>\n607\t          <div class=\"tool-foot\"><p>Box a button, a field, a row.</p><span class=\"keys\"><kbd>⌘</kbd><kbd>Drag</kbd></span></div>\n608\t        </article>\n609\t        <article class=\"tool\">\n610\t          <div class=\"spec\" data-ink><h3 class=\"w\" data-mark=\"ellipse\" data-pad=\"0.3em 0.2em\" data-color=\"blue\">Ellipse</h3></div>\n611\t          <div class=\"tool-foot\"><p>Circle it. This one's blue: press C.</p><span class=\"keys\"><kbd>⇧</kbd><kbd>⌘</kbd><kbd>Drag</kbd></span></div>\n612\t        </article>\n613\t        <article class=\"tool\">\n614\t          <div class=\"spec\"><h3 class=\"w\">Blur</h3><span class=\"secret\" role=\"img\" aria-label=\"A pixelated API key\">ex_live_9fK2mQ7xL4pR8tZ1</span></div>\n615\t          <div class=\"tool-foot\"><p>Pixelates keys, emails and faces, in blocks big enough to stay unreadable.</p><span class=\"keys\"><kbd>⌃</kbd><kbd>Drag</kbd></span></div>\n616\t        </article>\n617\t        <article class=\"tool\">\n618\t          <div class=\"spec\"><span class=\"crop-demo\" aria-hidden=\"true\">keep<span class=\"crop-win\">only this<i class=\"h tl\"></i><i class=\"h tr\"></i><i class=\"h bl\"></i><i class=\"h br\"></i></span>part</span><h3 class=\"sr\">Crop</h3></div>\n619\t          <div class=\"tool-foot\"><p><strong>Crop.</strong> Everything outside is left out of the image. Esc removes it.</p><span class=\"keys\"><kbd>⌥</kbd><kbd>Drag</kbd></span></div>\n620\t        </article>\n621\t        <article class=\"tool\">\n622\t          <div class=\"spec\" data-ink><h3 class=\"sr\">Text</h3><p class=\"note\" style=\"--delay:.1s\">Typed at the cursor<span class=\"caret\"></span></p></div>\n623\t          <div class=\"tool-foot\"><p><strong>Text.</strong> Enter or Esc finishes, ⇧⏎ adds a line, ⌘= and ⌘- resize. T over existing text edits it.</p><span class=\"keys\"><kbd>T</kbd></span></div>\n624\t        </article>\n625\t        <article class=\"tool\">\n626\t          <div class=\"spec\" data-ink><h3 class=\"w\">Badges</h3><span class=\"badges\" aria-hidden=\"true\"><span class=\"badge\" style=\"--delay:0s\">3</span><span class=\"badge\" style=\"--delay:.08s\">1</span><span class=\"badge\" style=\"--delay:.16s\">33</span><span class=\"badge\" style=\"--delay:.3s\">7</span></span></div>\n627\t          <div class=\"tool-foot\"><p>Press a digit to drop a numbered badge at the cursor. Two digits in a row make one number: 3, 3 → 33.</p><span class=\"keys\"><kbd>1</kbd><b>–</b><kbd>0</kbd></span></div>\n628\t        </article>\n629\t        <article class=\"tool\">\n630\t          <div class=\"spec\" data-ink><h3 class=\"sr\">Color</h3><span class=\"w\" data-mark=\"line\" data-off=\"4\">Red</span><span class=\"w\" style=\"color:var(--faint)\">or</span><span class=\"w\" data-mark=\"line\" data-off=\"4\" data-color=\"blue\">blue</span></div>\n631\t          <div class=\"tool-foot\"><p><strong>Color.</strong> Flips the mark under the cursor, or the color you draw with next.</p><span class=\"keys\"><kbd>C</kbd></span></div>\n632\t        </article>\n633\t        <article class=\"tool\">\n634\t          <div class=\"spec\" data-ink><h3 class=\"sr\">Capture time</h3><p class=\"note stamp\" id=\"stamp\">2026-09-30 12:00:00 UTC</p></div>\n635\t          <div class=\"tool-foot\"><p><strong>Capture time.</strong> Stamps when the screenshot was taken, in UTC. Above: when you opened this page.</p><span class=\"keys\"><kbd>U</kbd></span></div>\n636\t        </article>\n637\t      </div>\n638\t    </section>\n639\t\n640\t    <!-- EDITING -->\n641\t    <section class=\"wrap sec\" aria-labelledby=\"edit-h\">\n642\t      <div class=\"sec-head\">\n643\t        <h2 id=\"edit-h\">Everything stays editable.</h2>\n644\t        <p>Nothing is flattened until you send it. Hover a mark to get its handles.</p>\n645\t      </div>\n646\t      <div class=\"edit\">\n647\t        <div class=\"mock\" data-ink aria-hidden=\"true\">\n648\t          <div class=\"bar\"><i></i><i></i><i></i></div>\n649\t          <div class=\"warn\">⚠︎ <span>Use test keys while you build. <span class=\"u\" id=\"u-line\" data-mark=\"line\" data-off=\"7\" data-handles>Never share the production key.</span></span></div>\n650\t          <div class=\"rows\"><i style=\"width:72%\"></i><i style=\"width:54%\"></i></div>\n651\t          <span class=\"keybox\" data-mark=\"rect\" data-pad=\"7 7\" data-color=\"blue\" data-handles>ex_test_4hN8wC2vB6yD0sJ5</span>\n652\t        </div>\n653\t        <ul class=\"edit-list\">\n654\t          <li>Move a mark: drag its body<span class=\"keys sm\"><kbd>Drag</kbd></span></li>\n655\t          <li>Resize it: drag a handle<span class=\"keys sm\"><kbd>Drag</kbd><b>handle</b></span></li>\n656\t          <li>Delete the hovered mark<span class=\"keys sm\"><kbd>⌫</kbd></span></li>\n657\t          <li>Switch it between red and blue<span class=\"keys sm\"><kbd>C</kbd></span></li>\n658\t          <li>Undo, redo<span class=\"keys sm\"><kbd>⌘</kbd><kbd>Z</kbd><kbd>⇧</kbd><kbd>⌘</kbd><kbd>Z</kbd></span></li>\n659\t          <li>Edit text again: click it<span class=\"keys sm\"><kbd>Click</kbd></span></li>\n660\t        </ul>\n661\t      </div>\n662\t    </section>\n663\t\n664\t    <!-- SEND -->\n665\t    <section class=\"wrap sec\" aria-labelledby=\"send-h\">\n666\t      <div class=\"sec-head\">\n667\t        <h2 id=\"send-h\">Crop, then ⌘⏎ to copy.</h2>\n668\t        <p>Three ways out, one keystroke each. Pick which modifier does what in Settings. Changed your mind? <span class=\"keys sm\"><kbd>⌘</kbd><kbd>W</kbd></span> closes the window without saving.</p>\n669\t      </div>\n670\t      <div class=\"send\" data-ink>\n671\t        <p class=\"note paste-note\" id=\"paste-note\" data-mark=\"arrow\" data-to=\"#shot\" data-gap=\"10\">This is what gets pasted</p>\n672\t        <figure class=\"shot\">\n673\t          <div class=\"shot-img\" id=\"shot\"><img src=\"../assets/exported.webp\" alt=\"An annotated screenshot of an API keys page: numbered badges 1 to 3, the API keys tab circled, a warning underlined, the production key pixelated, the test key boxed in blue, and a red note with an arrow: Copy the test key.\" width=\"1744\" height=\"1086\" loading=\"lazy\" decoding=\"async\"></div>\n674\t        </figure>\n675\t        <ul class=\"outs\">\n676\t          <li><h3>Copy to clipboard <span class=\"keys sm\"><kbd>⌘</kbd><kbd>⏎</kbd></span></h3><p>Paste it straight into a chat, a ticket, a doc.</p></li>\n677\t          <li><h3>Save to a folder <span class=\"keys sm\"><kbd>⌥</kbd><kbd>⏎</kbd></span></h3><p>A PNG on your Desktop, or in any folder you choose.</p></li>\n678\t          <li><h3>Upload, copy the link <span class=\"keys sm\"><kbd>⌃</kbd><kbd>⏎</kbd></span></h3><p>Uploads to Uploadcare with your own public key and puts the link on the clipboard. If an upload fails, the screenshot is saved locally instead.</p></li>\n679\t        </ul>\n680\t      </div>\n681\t    </section>\n682\t\n683\t    <!-- MENU BAR -->\n684\t    <section class=\"wrap sec\" aria-labelledby=\"mb-h\">\n685\t      <div class=\"sec-head\">\n686\t        <h2 id=\"mb-h\">Out of the way until you need it.</h2>\n687\t      </div>\n688\t      <div class=\"mb\">\n689\t        <div class=\"desk\" data-ink aria-hidden=\"true\">\n690\t          <div class=\"menubar\">\n691\t            <span class=\"cam\" id=\"cam\" data-mark=\"ellipse\" data-pad=\"9 3\"><svg viewBox=\"0 0 24 24\"><path d=\"M4.5 7.5h3l1.6-2.2h5.8l1.6 2.2h3a1.5 1.5 0 0 1 1.5 1.5v8.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5V9a1.5 1.5 0 0 1 1.5-1.5Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"13\" r=\"3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></span>\n692\t            <svg viewBox=\"0 0 24 24\"><rect x=\"2.5\" y=\"8\" width=\"17\" height=\"8.5\" rx=\"2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><rect x=\"4.4\" y=\"9.9\" width=\"11\" height=\"4.7\" rx=\"1\" fill=\"currentColor\"/><path d=\"M21 10.8v3\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>\n693\t            <svg viewBox=\"0 0 24 24\"><path d=\"M3 9.5a13 13 0 0 1 18 0M6 12.8a8.5 8.5 0 0 1 12 0M9 16a4 4 0 0 1 6 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"19\" r=\"1.3\" fill=\"currentColor\"/></svg>\n694\t            <span>Tue 10:41</span>\n695\t          </div>\n696\t          <p class=\"note n-click\" data-mark=\"arrow\" data-to=\"#cam\" data-gap=\"16\">Click to capture</p>\n697\t          <div class=\"file\" data-mark=\"arrow\" data-to=\"#cam\" data-gap=\"16\" data-color=\"blue\"><i></i><i></i><i></i><span>shot.png</span></div>\n698\t          <p class=\"note blue n-drop\">Or drop an image on it</p>\n699\t        </div>\n700\t        <ul class=\"facts\">\n701\t          <li><b>One hotkey, your choice</b><span>⇧⌘5 by default. Record a different one in Settings.</span></li>\n702\t          <li><b>The display you're on</b><span>With more than one screen, Skryn captures the one under your cursor.</span></li>\n703\t          <li><b>Drop an image on the icon</b><span>Drag an image file onto the menu bar icon to annotate it like a screenshot.</span></li>\n704\t          <li><b>Launch at login</b><span>One checkbox in Settings.</span></li>\n705\t        </ul>\n706\t      </div>\n707\t    </section>\n708\t\n709\t    <!-- INSTALL -->\n710\t    <section id=\"install\" class=\"wrap sec\" aria-labelledby=\"inst-h\">\n711\t      <div class=\"sec-head\">\n712\t        <h2 id=\"inst-h\">Installation</h2>\n713\t      </div>\n714\t      <div class=\"install\">\n715\t        <ol data-ink>\n716\t          <li><span class=\"badge\" style=\"--delay:0s\">1</span><span>Download <strong>Skryn.zip</strong> from the <a href=\"https://github.com/rsedykh/skryn/releases/latest\">latest release</a>.</span></li>\n717\t          <li><span class=\"badge\" style=\"--delay:.1s\">2</span><span>Unzip it and drag <strong>Skryn.app</strong> to Applications.</span></li>\n718\t          <li><span class=\"badge\" style=\"--delay:.2s\">3</span><span>Open it. macOS blocks the first launch because Skryn isn't notarized: go to <strong>System Settings → Privacy &amp; Security</strong> and click <strong>Open Anyway</strong>.<small>On macOS 14, right-click the app → Open also works.</small></span></li>\n719\t          <li><span class=\"badge\" style=\"--delay:.3s\">4</span><span>Grant <strong>Screen Recording</strong> permission when asked.</span></li>\n720\t        </ol>\n721\t        <aside class=\"update\" aria-labelledby=\"upd-h\">\n722\t          <h3 id=\"upd-h\">Updating</h3>\n723\t          <p>Since v0.1.6, Skryn is signed with a stable certificate, so Screen Recording permission carries over when you update.</p>\n724\t          <p>Coming from v0.1.5 or earlier? The signature changed, so reset it once if screenshots stop working:</p>\n725\t          <ol>\n726\t            <li>System Settings → Privacy &amp; Security → Screen Recording</li>\n727\t            <li>Remove Skryn from the list</li>\n728\t            <li>Take a screenshot. Skryn asks for permission again.</li>\n729\t          </ol>\n730\t        </aside>\n731\t      </div>\n732\t    </section>\n733\t\n734\t    <!-- CLOSING -->\n735\t    <section class=\"wrap end\" aria-labelledby=\"end-h\">\n736\t      <h2 id=\"end-h\">Skryn</h2>\n737\t      <p class=\"lede\" style=\"margin-top:0\">Screenshot and annotate, from the menu bar.</p>\n738\t      <div class=\"end-cta\" data-ink>\n739\t        <a id=\"dl-end\" class=\"download\" href=\"https://github.com/rsedykh/skryn/releases/latest\" data-mark=\"rect\" data-pad=\"9 9\">\n740\t          <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 2.5v10m0 0-4-4m4 4 4-4M3.5 15.5h13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n741\t          Download for macOS\n742\t        </a>\n743\t        <p class=\"note\" data-mark=\"arrow\" data-to=\"#dl-end\" data-gap=\"20\">Your turn</p>\n744\t      </div>\n745\t      <p class=\"cta-meta\">macOS 14 or later</p>\n746\t    </section>\n747\t  </main>\n748\t\n749\t  <footer>\n750\t    <div class=\"wrap\">\n751\t      <span>Skryn · a macOS menu bar app</span>\n752\t      <span><a href=\"https://github.com/rsedykh/skryn\">GitHub</a> · <a href=\"https://github.com/rsedykh/skryn/releases\">Releases</a></span>\n753\t    </div>\n754\t  </footer>\n755\t"}]},"uuid":"01dbbe94-f239-4f84-ab6e-b922d1b46f71","timestamp":"2026-10-02T22:53:57.615Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/rsedykh/GitHub/skryn/docs/v3/index.html","content":"<body>\n  <script>document.documentElement.classList.add('js')</script>\n\n  <header class=\"top\">\n    <div class=\"wrap top-in\">\n    <a class=\"brand\" href=\"#top\" aria-label=\"Skryn, back to top\"><img src=\"../assets/icon.svg\" alt=\"\" width=\"34\" height=\"34\">Skryn</a>\n    <nav aria-label=\"Sections\">\n      <a href=\"#demo\" id=\"nav-demo\">Demo</a>\n      <a href=\"#tools\">Tools</a>\n      <a href=\"#install\">Install</a>\n      <a class=\"gh\" href=\"https://github.com/rsedykh/skryn\">GitHub</a>\n      <a class=\"nav-dl\" href=\"https://github.com/rsedykh/skryn/releases/latest\">Download</a>\n    </nav>\n    </div>\n  </header>\n\n  <main id=\"top\">\n    <!-- HERO -->\n    <section class=\"wrap hero\" aria-labelledby=\"hero-h\">\n      <div data-ink>\n        <h1 id=\"hero-h\">\n          <span>Screenshot it.<span class=\"keys sm tag\" aria-hidden=\"true\"><kbd>⇧</kbd><kbd>⌘</kbd><kbd>5</kbd><b>capture</b></span></span>\n          <span><span class=\"circled\" data-mark=\"ellipse\" data-pad=\"0.15em 0.07em\">Mark it up.</span><span class=\"keys sm tag\" aria-hidden=\"true\"><kbd>⇧</kbd><kbd>⌘</kbd><kbd>Drag</kbd><b>ellipse</b></span></span>\n          <span>Send it.<span class=\"keys sm tag\" aria-hidden=\"true\"><kbd>⌘</kbd><kbd>⏎</kbd><b>copy</b></span></span>\n        </h1>\n        <p class=\"lede\">Skryn lives in your Mac's menu bar. Press <strong>⇧⌘5</strong>, mark up the screenshot with arrows, boxes, blur, text and numbered steps, then copy, save or upload it with one keystroke.</p>\n        <div class=\"cta-row\">\n          <a id=\"dl\" class=\"download\" href=\"https://github.com/rsedykh/skryn/releases/latest\" data-mark=\"rect\" data-pad=\"9 9\">\n            <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 2.5v10m0 0-4-4m4 4 4-4M3.5 15.5h13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Download for macOS\n          </a>\n          <div class=\"start\">\n            <p class=\"note\" data-mark=\"arrow\" data-to=\"#dl\" data-gap=\"20\">Start here</p>\n            <span class=\"keys sm legend\" aria-hidden=\"true\"><span><kbd>T</kbd></span><b>text</b><span><kbd>Drag</kbd></span><b>arrow</b><span><kbd>⌘</kbd><kbd>Drag</kbd></span><b>rectangle</b></span>\n          </div>\n          <p class=\"cta-meta\">macOS 14 or later · <a href=\"https://github.com/rsedykh/skryn\">Source on GitHub</a></p>\n        </div>\n      </div>\n    </section>\n\n    <!-- DEMO: live playground on a laptop, the video on phones (and for no-JS) -->\n    <section class=\"stage\" id=\"demo\" aria-label=\"Demo\">\n      <div class=\"stage-cap above\">\n        <span class=\"keys v-only\" aria-hidden=\"true\"><kbd>⌥</kbd><kbd>Drag</kbd><b>crop</b></span>\n      </div>\n      <div class=\"crop-frame\">\n        <video controls playsinline preload=\"none\" poster=\"../assets/poster.webp\" aria-label=\"Skryn demo video: capture, annotate, crop and paste\">\n          <source src=\"https://github.com/user-attachments/assets/fad9d1f0-c079-474f-95c9-f9be2e1e02a7\" type=\"video/mp4\">\n          <a href=\"https://github.com/user-attachments/assets/fad9d1f0-c079-474f-95c9-f9be2e1e02a7\">Watch the demo video</a>\n        </video>\n        <button class=\"play\" type=\"button\" aria-label=\"Play the demo video\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5.2v13.6a1 1 0 0 0 1.5.86l11-6.8a1 1 0 0 0 0-1.72l-11-6.8A1 1 0 0 0 8 5.2Z\" fill=\"currentColor\"/></svg></span></button>\n        <div class=\"pg-win\" id=\"pg\" tabindex=\"0\" role=\"application\" aria-roledescription=\"annotation playground\" inert\n             aria-label=\"Annotation playground. Drag to draw an arrow. Hold Shift for a line, Command for a rectangle, Shift and Command for an ellipse, Control for blur, Option for crop. Digits place badges, T types text, C switches color.\">\n          <img data-src=\"../assets/shot.webp\" width=\"872\" height=\"543\" alt=\"Sample screenshot: the API keys page of a fictional Example Cloud console, with a production key, a test key and a revoked key.\" draggable=\"false\">\n          <canvas aria-hidden=\"true\"></canvas>\n          <div class=\"pg-toast\" role=\"status\" aria-live=\"polite\"></div>\n        </div>\n        <div class=\"gate\">\n          <canvas aria-hidden=\"true\"></canvas>\n          <div class=\"gate-ui\">\n            <div class=\"gate-btns\">\n              <button type=\"button\" class=\"gate-try\">Try it</button>\n              <button type=\"button\" class=\"gate-watch\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5.2v13.6a1 1 0 0 0 1.5.86l11-6.8a1 1 0 0 0 0-1.72l-11-6.8A1 1 0 0 0 8 5.2Z\" fill=\"currentColor\"/></svg>Watch the video</button>\n            </div>\n            <p>A browser replica of Skryn's annotation window. Same keys as the app.</p>\n          </div>\n          <span class=\"keys sm gate-tag\" aria-hidden=\"true\"><kbd>⌃</kbd><kbd>Drag</kbd><b>blur</b></span>\n        </div>\n        <i class=\"h tl\"></i><i class=\"h tr\"></i><i class=\"h bl\"></i><i class=\"h br\"></i>\n      </div>\n      <div class=\"pg-bar\" id=\"pg-bar\" role=\"toolbar\" aria-label=\"Playground tools\">\n        <button class=\"tb\" type=\"button\" data-tool=\"arrow\" aria-pressed=\"false\"><kbd>Drag</kbd>Arrow</button>\n        <button class=\"tb\" type=\"button\" data-tool=\"line\" aria-pressed=\"false\"><kbd>⇧</kbd>Line</button>\n        <button class=\"tb\" type=\"button\" data-tool=\"rect\" aria-pressed=\"false\"><kbd>⌘</kbd>Rect</button>\n        <button class=\"tb\" type=\"button\" data-tool=\"ellipse\" aria-pressed=\"false\"><kbd>⇧⌘</kbd>Ellipse</button>\n        <button class=\"tb\" type=\"button\" data-tool=\"blur\" aria-pressed=\"false\"><kbd>⌃</kbd>Blur</button>\n        <button class=\"tb\" type=\"button\" data-tool=\"crop\" aria-pressed=\"false\"><kbd>⌥</kbd>Crop</button>\n        <button class=\"tb\" type=\"button\" data-tool=\"badge\" aria-pressed=\"false\"><kbd>1–0</kbd>Badge</button>\n        <button class=\"tb\" type=\"button\" data-tool=\"text\" aria-pressed=\"false\"><kbd>T</kbd>Text</button>\n        <span class=\"pg-sep\" aria-hidden=\"true\"></span>\n        <button class=\"tb\" type=\"button\" data-act=\"color\" aria-label=\"Switch color (C)\"><kbd>C</kbd><span><i class=\"dot\" aria-hidden=\"true\"></i><span class=\"cname\">Red</span></span></button>\n        <button class=\"tb\" type=\"button\" data-act=\"undo\" aria-label=\"Undo (Command Z)\"><kbd>⌘Z</kbd>Undo</button>\n        <button class=\"tb\" type=\"button\" data-act=\"redo\" aria-label=\"Redo (Shift Command Z)\"><kbd>⇧⌘Z</kbd>Redo</button>\n        <button class=\"tb\" type=\"button\" data-act=\"reset\" aria-label=\"Clear all marks\"><kbd>↺</kbd>Clear</button>\n        <span class=\"pg-sep\" aria-hidden=\"true\"></span>\n        <button class=\"tb\" type=\"button\" data-act=\"copy\" aria-label=\"Copy to clipboard (Command Return)\"><kbd>⌘⏎</kbd>Copy</button>\n        <button class=\"tb\" type=\"button\" data-act=\"save\" aria-label=\"Save PNG (Option Return)\"><kbd>⌥⏎</kbd>Save</button>\n        <button class=\"tb\" type=\"button\" data-act=\"upload\" aria-label=\"Upload (Control Return)\"><kbd>⌃⏎</kbd>Upload</button>\n      </div>\n      <div class=\"stage-cap below\">\n        <span class=\"keys v-only\" aria-hidden=\"true\"><kbd>Esc</kbd><b>remove crop</b></span>\n        <button type=\"button\" class=\"switch\"></button>\n      </div>\n    </section>\n\n\n    <!-- TOOLS -->\n    <section id=\"tools\" class=\"wrap sec\" aria-labelledby=\"tools-h\">\n      <div class=\"sec-head\">\n        <h2 id=\"tools-h\">Hold a key. Pick a tool.</h2>\n        <p>Each tool below is marked up with itself. The modifier you hold when you start dragging decides what you draw.</p>\n      </div>\n      <div class=\"tools\">\n        <article class=\"tool\">\n          <div class=\"spec arrow\" data-ink>\n            <h3 class=\"w\" id=\"w-arrow\">Arrow</h3>\n            <i class=\"tail\" data-mark=\"arrow\" data-to=\"#w-arrow\" data-gap=\"10\"></i>\n          </div>\n          <div class=\"tool-foot\"><p>Point at the thing. No modifier needed.</p><span class=\"keys\"><kbd>Drag</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\" data-ink><h3 class=\"w\" data-mark=\"line\" data-off=\"6\">Line</h3></div>\n          <div class=\"tool-foot\"><p>Underline a warning, strike a path.</p><span class=\"keys\"><kbd>⇧</kbd><kbd>Drag</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\" data-ink><h3 class=\"w\" data-mark=\"rect\" data-pad=\"0.2em 0.22em\">Rectangle</h3></div>\n          <div class=\"tool-foot\"><p>Box a button, a field, a row.</p><span class=\"keys\"><kbd>⌘</kbd><kbd>Drag</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\" data-ink><h3 class=\"w\" data-mark=\"ellipse\" data-pad=\"0.3em 0.2em\" data-color=\"blue\">Ellipse</h3></div>\n          <div class=\"tool-foot\"><p>Circle it. This one's blue: press C.</p><span class=\"keys\"><kbd>⇧</kbd><kbd>⌘</kbd><kbd>Drag</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\"><h3 class=\"w\">Blur</h3><span class=\"secret\" role=\"img\" aria-label=\"A pixelated API key\">ex_live_9fK2mQ7xL4pR8tZ1</span></div>\n          <div class=\"tool-foot\"><p>Pixelates keys, emails and faces, in blocks big enough to stay unreadable.</p><span class=\"keys\"><kbd>⌃</kbd><kbd>Drag</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\"><span class=\"crop-demo\" aria-hidden=\"true\">keep<span class=\"crop-win\">only this<i class=\"h tl\"></i><i class=\"h tr\"></i><i class=\"h bl\"></i><i class=\"h br\"></i></span>part</span><h3 class=\"sr\">Crop</h3></div>\n          <div class=\"tool-foot\"><p><strong>Crop.</strong> Everything outside is left out of the image. Esc removes it.</p><span class=\"keys\"><kbd>⌥</kbd><kbd>Drag</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\" data-ink><h3 class=\"sr\">Text</h3><p class=\"note\" style=\"--delay:.1s\">Typed at the cursor<span class=\"caret\"></span></p></div>\n          <div class=\"tool-foot\"><p><strong>Text.</strong> Enter or Esc finishes, ⇧⏎ adds a line, ⌘= and ⌘- resize. T over existing text edits it.</p><span class=\"keys\"><kbd>T</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\" data-ink><h3 class=\"w\">Badges</h3><span class=\"badges\" aria-hidden=\"true\"><span class=\"badge\" style=\"--delay:0s\">3</span><span class=\"badge\" style=\"--delay:.08s\">1</span><span class=\"badge\" style=\"--delay:.16s\">33</span><span class=\"badge\" style=\"--delay:.3s\">7</span></span></div>\n          <div class=\"tool-foot\"><p>Press a digit to drop a numbered badge at the cursor. Two digits in a row make one number: 3, 3 → 33.</p><span class=\"keys\"><kbd>1</kbd><b>–</b><kbd>0</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\" data-ink><h3 class=\"sr\">Color</h3><span class=\"w\" data-mark=\"line\" data-off=\"4\">Red</span><span class=\"w\" style=\"color:var(--faint)\">or</span><span class=\"w\" data-mark=\"line\" data-off=\"4\" data-color=\"blue\">blue</span></div>\n          <div class=\"tool-foot\"><p><strong>Color.</strong> Flips the mark under the cursor, or the color you draw with next.</p><span class=\"keys\"><kbd>C</kbd></span></div>\n        </article>\n        <article class=\"tool\">\n          <div class=\"spec\" data-ink><h3 class=\"sr\">Capture time</h3><p class=\"note stamp\" id=\"stamp\">2026-09-30 12:00:00 UTC</p></div>\n          <div class=\"tool-foot\"><p><strong>Capture time.</strong> Stamps when the screenshot was taken, in UTC. Above: when you opened this page.</p><span class=\"keys\"><kbd>U</kbd></span></div>\n        </article>\n      </div>\n    </section>\n\n    <!-- EDITING -->\n    <section class=\"wrap sec\" aria-labelledby=\"edit-h\">\n      <div class=\"sec-head\">\n        <h2 id=\"edit-h\">Everything stays editable.</h2>\n        <p>Nothing is flattened until you send it. Hover a mark to get its handles.</p>\n      </div>\n      <div class=\"edit\">\n        <div class=\"mock\" data-ink aria-hidden=\"true\">\n          <div class=\"bar\"><i></i><i></i><i></i></div>\n          <div class=\"warn\">⚠︎ <span>Use test keys while you build. <span class=\"u\" id=\"u-line\" data-mark=\"line\" data-off=\"7\" data-handles>Never share the production key.</span></span></div>\n          <div class=\"rows\"><i style=\"width:72%\"></i><i style=\"width:54%\"></i></div>\n          <span class=\"keybox\" data-mark=\"rect\" data-pad=\"7 7\" data-color=\"blue\" data-handles>ex_test_4hN8wC2vB6yD0sJ5</span>\n        </div>\n        <ul class=\"edit-list\">\n          <li>Move a mark: drag its body<span class=\"keys sm\"><kbd>Drag</kbd></span></li>\n          <li>Resize it: drag a handle<span class=\"keys sm\"><kbd>Drag</kbd><b>handle</b></span></li>\n          <li>Delete the hovered mark<span class=\"keys sm\"><kbd>⌫</kbd></span></li>\n          <li>Switch it between red and blue<span class=\"keys sm\"><kbd>C</kbd></span></li>\n          <li>Undo, redo<span class=\"keys sm\"><kbd>⌘</kbd><kbd>Z</kbd><kbd>⇧</kbd><kbd>⌘</kbd><kbd>Z</kbd></span></li>\n          <li>Edit text again: click it<span class=\"keys sm\"><kbd>Click</kbd></span></li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- SEND -->\n    <section class=\"wrap sec\" aria-labelledby=\"send-h\">\n      <div class=\"sec-head\">\n        <h2 id=\"send-h\">Crop, then ⌘⏎ to copy.</h2>\n        <p>Three ways out, one keystroke each. Pick which modifier does what in Settings. Changed your mind? <span class=\"keys sm\"><kbd>⌘</kbd><kbd>W</kbd></span> closes the window without saving.</p>\n      </div>\n      <div class=\"send\" data-ink>\n        <p class=\"note paste-note\" id=\"paste-note\" data-mark=\"arrow\" data-to=\"#shot\" data-gap=\"10\">This is what gets pasted</p>\n        <figure class=\"shot\">\n          <div class=\"shot-img\" id=\"shot\"><img src=\"../assets/exported.webp\" alt=\"An annotated screenshot of an API keys page: numbered badges 1 to 3, the API keys tab circled, a warning underlined, the production key pixelated, the test key boxed in blue, and a red note with an arrow: Copy the test key.\" width=\"1744\" height=\"1086\" loading=\"lazy\" decoding=\"async\"></div>\n        </figure>\n        <ul class=\"outs\">\n          <li><h3>Copy to clipboard <span class=\"keys sm\"><kbd>⌘</kbd><kbd>⏎</kbd></span></h3><p>Paste it straight into a chat, a ticket, a doc.</p></li>\n          <li><h3>Save to a folder <span class=\"keys sm\"><kbd>⌥</kbd><kbd>⏎</kbd></span></h3><p>A PNG on your Desktop, or in any folder you choose.</p></li>\n          <li><h3>Upload, copy the link <span class=\"keys sm\"><kbd>⌃</kbd><kbd>⏎</kbd></span></h3><p>Uploads to Uploadcare with your own public key and puts the link on the clipboard. If an upload fails, the screenshot is saved locally instead.</p></li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- MENU BAR -->\n    <section class=\"wrap sec\" aria-labelledby=\"mb-h\">\n      <div class=\"sec-head\">\n        <h2 id=\"mb-h\">Out of the way until you need it.</h2>\n      </div>\n      <div class=\"mb\">\n        <div class=\"desk\" data-ink aria-hidden=\"true\">\n          <div class=\"menubar\">\n            <span class=\"cam\" id=\"cam\" data-mark=\"ellipse\" data-pad=\"9 3\"><svg viewBox=\"0 0 24 24\"><path d=\"M4.5 7.5h3l1.6-2.2h5.8l1.6 2.2h3a1.5 1.5 0 0 1 1.5 1.5v8.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5V9a1.5 1.5 0 0 1 1.5-1.5Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"13\" r=\"3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></span>\n            <svg viewBox=\"0 0 24 24\"><rect x=\"2.5\" y=\"8\" width=\"17\" height=\"8.5\" rx=\"2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><rect x=\"4.4\" y=\"9.9\" width=\"11\" height=\"4.7\" rx=\"1\" fill=\"currentColor\"/><path d=\"M21 10.8v3\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>\n            <svg viewBox=\"0 0 24 24\"><path d=\"M3 9.5a13 13 0 0 1 18 0M6 12.8a8.5 8.5 0 0 1 12 0M9 16a4 4 0 0 1 6 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"19\" r=\"1.3\" fill=\"currentColor\"/></svg>\n            <span>Tue 10:41</span>\n          </div>\n          <p class=\"note n-click\" data-mark=\"arrow\" data-to=\"#cam\" data-gap=\"16\">Click to capture</p>\n          <div class=\"file\" data-mark=\"arrow\" data-to=\"#cam\" data-gap=\"16\" data-color=\"blue\"><i></i><i></i><i></i><span>shot.png</span></div>\n          <p class=\"note blue n-drop\">Or drop an image on it</p>\n        </div>\n        <ul class=\"facts\">\n          <li><b>One hotkey, your choice</b><span>⇧⌘5 by default. Record a different one in Settings.</span></li>\n          <li><b>The display you're on</b><span>With more than one screen, Skryn captures the one under your cursor.</span></li>\n          <li><b>Drop an image on the icon</b><span>Drag an image file onto the menu bar icon to annotate it like a screenshot.</span></li>\n          <li><b>Launch at login</b><span>One checkbox in Settings.</span></li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- INSTALL -->\n    <section id=\"install\" class=\"wrap sec\" aria-labelledby=\"inst-h\">\n      <div class=\"sec-head\">\n        <h2 id=\"inst-h\">Installation</h2>\n      </div>\n      <div class=\"install\">\n        <ol data-ink>\n          <li><span class=\"badge\" style=\"--delay:0s\">1</span><span>Download <strong>Skryn.zip</strong> from the <a href=\"https://github.com/rsedykh/skryn/releases/latest\">latest release</a>.</span></li>\n          <li><span class=\"badge\" style=\"--delay:.1s\">2</span><span>Unzip it and drag <strong>Skryn.app</strong> to Applications.</span></li>\n          <li><span class=\"badge\" style=\"--delay:.2s\">3</span><span>Open it. macOS blocks the first launch because Skryn isn't notarized: go to <strong>System Settings → Privacy &amp; Security</strong> and click <strong>Open Anyway</strong>.<small>On macOS 14, right-click the app → Open also works.</small></span></li>\n          <li><span class=\"badge\" style=\"--delay:.3s\">4</span><span>Grant <strong>Screen Recording</strong> permission when asked.</span></li>\n        </ol>\n        <aside class=\"update\" aria-labelledby=\"upd-h\">\n          <h3 id=\"upd-h\">Updating</h3>\n          <p>Since v0.1.6, Skryn is signed with a stable certificate, so Screen Recording permission carries over when you update.</p>\n          <p>Coming from v0.1.5 or earlier? The signature changed, so reset it once if screenshots stop working:</p>\n          <ol>\n            <li>System Settings → Privacy &amp; Security → Screen Recording</li>\n            <li>Remove Skryn from the list</li>\n            <li>Take a screenshot. Skryn asks for permission again.</li>\n          </ol>\n        </aside>\n      </div>\n    </section>\n\n    <!-- CLOSING -->\n    <section class=\"wrap end\" aria-labelledby=\"end-h\">\n      <h2 id=\"end-h\">Skryn</h2>\n      <p class=\"lede\" style=\"margin-top:0\">Screenshot and annotate, from the menu bar.</p>\n      <div class=\"end-cta\" data-ink>\n        <a id=\"dl-end\" class=\"download\" href=\"https://github.com/rsedykh/skryn/releases/latest\" data-mark=\"rect\" data-pad=\"9 9\">\n          <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 2.5v10m0 0-4-4m4 4 4-4M3.5 15.5h13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          Download for macOS\n        </a>\n        <p class=\"note\" data-mark=\"arrow\" data-to=\"#dl-end\" data-gap=\"20\">Your turn</p>\n      </div>\n      <p class=\"cta-meta\">macOS 14 or later</p>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap\">\n      <span>Skryn · a macOS menu bar app</span>\n      <span><a href=\"https://github.com/rsedykh/skryn\">GitHub</a> · <a href=\"https://github.com/rsedykh/skryn/releases\">Releases</a></span>\n    </div>\n  </footer>\n","numLines":265,"startLine":491,"totalLines":1722}},"sourceToolAssistantUUID":"60e25830-4f6d-4446-bbea-301812b1403c","session_id":"71183914-e83d-4503-afe0-4d46d21c5038","userType":"external","entrypoint":"cli","cwd":"/Users/rsedykh/GitHub/skryn","sessionId":"71183914-e83d-4503-afe0-4d46d21c5038","version":"2.1.286","gitBranch":"main"}
