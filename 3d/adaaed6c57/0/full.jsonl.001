, \"    </section>\\n\\n    <!-- TOOLS -->\")\nrep(\"    <!-- SEND -->\", \"    <!-- OUTPUT -->\")\n\n# ================= JS =================\na = s.index(\"  <script>\\n  (() => {\\n    const NS\")\nz = s.rindex(\"  </script>\")\nscript = s[a:z]\n\n\ndef body(text, start_marker, end_marker):\n    i = text.index(start_marker) + len(start_marker)\n    j = text.index(end_marker, i)\n    return text[i:j]\n\n\nmarks = body(script, \"  <script>\\n  (() => {\\n\", \"\\n  })();\\n\\n  // Demo:\")\ndemo = body(script, \"  // Demo: the playground behind Skryn's blur on a laptop, the video everywhere else\\n  (() => {\\n\", \"\\n  })();\\n\")\npg_start = script.index(\"// Playground: a browser replica\")\npg = body(script[pg_start:], \"(() => {\\n\", \"\\n})();\")\n\n\ndef indent(text, n):\n    return \"\\n\".join((\" \" * n + l) if l.strip() else \"\" for l in text.split(\"\\n\"))\n\n\ndef dedent(text, n):\n    out = []\n    for l in text.split(\"\\n\"):\n        assert not l.strip() or l.startswith(\" \" * n), l\n        out.append(l[n:])\n    return \"\\n\".join(out)\n\n\n# --- marks: nav code out, constants together, the fake key uses mosaic() ---\nmarks = rep('''    const NS = 'http://www.w3.org/2000/svg';\n\n    const bar = document.querySelector('.top');\n    const onScroll = () => bar.classList.toggle('scrolled', scrollY > 8);\n    addEventListener('scroll', onScroll, { passive: true });\n    onScroll();\n    const HEAD = 18, HEAD_ANGLE = Math.PI / 6, STROKE = 3;\n\n\n    // Capture-time stamp''', '''    const NS = 'http://www.w3.org/2000/svg';\n    const HEAD = 18, HEAD_ANGLE = Math.PI / 6, STROKE = 3; // the app's arrowhead and stroke\n\n    // Capture-time stamp''', marks)\nmarks = rep('''    // Pixelate like Skryn's blur: grayscale, then square blocks at least 10pt wide, colored from each block's center\n    function pixelate(el) {\n      const w = el.offsetWidth, h = el.offsetHeight;\n      if (!w || !h) return;\n      const cs = getComputedStyle(el), dpr = Math.min(window.devicePixelRatio || 1, 3);\n      const W = Math.round(w * dpr), H = Math.round(h * dpr);\n      const src = document.createElement('canvas');\n      src.width = W; src.height = H;\n      const s = src.getContext('2d', { willReadFrequently: true });\n      s.fillStyle = cs.backgroundColor; s.fillRect(0, 0, W, H);\n      s.fillStyle = cs.getPropertyValue('--secret-ink').trim() || '#333';\n      s.font = `${cs.fontWeight} ${parseFloat(cs.fontSize) * dpr}px ${cs.fontFamily}`;\n      s.textBaseline = 'middle';\n      s.fillText(el.textContent.trim(), parseFloat(cs.paddingLeft) * dpr, H / 2 + dpr);\n      const px = s.getImageData(0, 0, W, H).data;\n      const block = Math.max(Math.max(w, h) / 40, 10) * dpr;\n      const c = el.querySelector('canvas') || el.appendChild(document.createElement('canvas'));\n      c.width = W; c.height = H;\n      const o = c.getContext('2d');\n      for (let by = 0; by < H; by += block) {\n        for (let bx = 0; bx < W; bx += block) {\n          const cx = Math.min(W - 1, Math.floor(bx + block / 2)), cy = Math.min(H - 1, Math.floor(by + block / 2));\n          const k = (cy * W + cx) * 4;\n          const l = Math.round(0.2126 * px[k] + 0.7152 * px[k + 1] + 0.0722 * px[k + 2]);\n          o.fillStyle = `rgb(${l},${l},${l})`;\n          o.fillRect(Math.floor(bx), Math.floor(by), Math.ceil(block) + 1, Math.ceil(block) + 1);\n        }\n      }\n      el.classList.add('done');\n    }''', '''    // The Blur cell's fake key: the text drawn to a canvas, then Skryn's blur with the app's block size (max(w, h) / 40, at least 10pt)\n    function pixelate(el) {\n      const w = el.offsetWidth, h = el.offsetHeight;\n      if (!w || !h) return;\n      const cs = getComputedStyle(el), dpr = Math.min(window.devicePixelRatio || 1, 3);\n      const W = Math.round(w * dpr), H = Math.round(h * dpr);\n      const src = document.createElement('canvas');\n      src.width = W; src.height = H;\n      const s = src.getContext('2d');\n      s.fillStyle = cs.backgroundColor; s.fillRect(0, 0, W, H);\n      s.fillStyle = cs.getPropertyValue('--secret-ink').trim() || '#333';\n      s.font = `${cs.fontWeight} ${parseFloat(cs.fontSize) * dpr}px ${cs.fontFamily}`;\n      s.textBaseline = 'middle';\n      s.fillText(el.textContent.trim(), parseFloat(cs.paddingLeft) * dpr, H / 2 + dpr);\n      const block = Math.max(Math.max(w, h) / 40, 10) * dpr;\n      const m = mosaic(src, 0, 0, W, H, block);\n      const c = el.querySelector('canvas') || el.appendChild(document.createElement('canvas'));\n      c.width = W; c.height = H;\n      const o = c.getContext('2d');\n      o.imageSmoothingEnabled = false;\n      o.drawImage(m.canvas, 0, 0, m.nx * block, m.ny * block);\n      el.classList.add('done');\n    }''', marks)\n\n# --- demo controller ---\ndemo = re.sub(r\"\\bstage\\b\", \"demo\", demo)\ndemo = rep(\"    const pg = document.getElementById('pg'), gate = demo.querySelector('.gate'), gc = gate.querySelector('canvas');\",\n           \"    const pg = document.getElementById('pg'), gate = demo.querySelector('.gate'), gc = gate.querySelector('canvas');\", demo)\ndemo = rep(\"    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;\", \"    if (!FINE_POINTER) return;\", demo)\ndemo = rep('''    let composite = null, opening = false;''', '''    let gateSrc = null, block0 = 0, opening = false; // gateSrc: the seeded playground, rendered once''', demo)\ndemo = rep('''    // Skryn's blur over the whole frame: grayscale, square blocks sampled at their centers, max(w, h) / 40 wide\n    const W = 872, H = 543, BLOCK = Math.max(W, H) / 40;\n    function drawGate(b, gray) {\n      if (!composite) return;\n      const src = composite(), dpr = Math.min(devicePixelRatio || 1, 2);\n      gc.width = Math.round(gc.clientWidth * dpr); gc.height = Math.round(gc.clientHeight * dpr);\n      const g = gc.getContext('2d');\n      if (b <= 1) { g.imageSmoothingEnabled = true; g.drawImage(src, 0, 0, gc.width, gc.height); return; }\n      const nx = Math.ceil(W / b), ny = Math.ceil(H / b);\n      const t = document.createElement('canvas'); t.width = nx; t.height = ny;\n      const tc = t.getContext('2d', { willReadFrequently: true });\n      tc.imageSmoothingEnabled = false;\n      tc.drawImage(src, 0, 0, nx * b * src.width / W, ny * b * src.height / H, 0, 0, nx, ny);\n      if (gray > 0) {\n        const d = tc.getImageData(0, 0, nx, ny), q = d.data;\n        for (let i = 0; i < q.length; i += 4) {\n          const l = .299 * q[i] + .587 * q[i + 1] + .114 * q[i + 2];\n          q[i] += (l - q[i]) * gray; q[i + 1] += (l - q[i + 1]) * gray; q[i + 2] += (l - q[i + 2]) * gray;\n        }\n        tc.putImageData(d, 0, 0);\n      }\n      g.imageSmoothingEnabled = false;\n      g.drawImage(t, 0, 0, nx * b / W * gc.width, ny * b / H * gc.height);\n    }\n    pg.addEventListener('pg-ready', (e) => { composite = e.detail.composite; drawGate(BLOCK, 1); });\n    new ResizeObserver(() => { if (demo.classList.contains('gated') && !opening) drawGate(BLOCK, 1); }).observe(gate);''',\n'''    // Skryn's blur over the whole frame, with the app's block size for an image this big: max(w, h) / 40\n    function drawGate(block, gray) {\n      const dpr = Math.min(devicePixelRatio || 1, 2);\n      gc.width = Math.round(gc.clientWidth * dpr); gc.height = Math.round(gc.clientHeight * dpr);\n      const g = gc.getContext('2d');\n      if (block <= 2) { g.imageSmoothingEnabled = true; g.drawImage(gateSrc, 0, 0, gc.width, gc.height); return; }\n      const m = mosaic(gateSrc, 0, 0, gateSrc.width, gateSrc.height, block, gray);\n      g.imageSmoothingEnabled = false;\n      g.drawImage(m.canvas, 0, 0, m.nx * block * gc.width / gateSrc.width, m.ny * block * gc.height / gateSrc.height);\n    }\n    pg.addEventListener('pg-ready', (e) => {\n      gateSrc = e.detail.composite();\n      block0 = Math.max(gateSrc.width, gateSrc.height) / 40;\n      drawGate(block0, 1);\n    });\n    new ResizeObserver(() => { if (gateSrc && demo.classList.contains('gated') && !opening) drawGate(block0, 1); }).observe(gate);''', demo)\ndemo = rep('''      if (reduce || !composite) return done();''', '''      if (reduce || !gateSrc) return done();''', demo)\ndemo = rep('''        drawGate(Math.max(1, BLOCK * Math.pow(1 / BLOCK, e)), 1 - e);''',\n           '''        drawGate(block0 * Math.pow(2 / block0, e), 1 - e); // blocks shrink to 2px, color comes back''', demo)\nassert \"composite\" not in demo.replace(\"e.detail.composite\", \"\")\n\n# --- playground ---\npg = rep(\"  if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return; // phones and tablets get the video\\n\",\n         \"  if (!FINE_POINTER) return;\\n\", pg)\npg = rep(\"  const touchDevice = matchMedia('(hover: none)').matches;\\n  if (touchDevice) { stage.classList.add('touch'); document.documentElement.classList.add('touch-page'); }\\n\", \"\", pg)\npg = rep('''    // iOS zooms the page into inputs under 16px, so on touch the box is set at 16px+ and scaled down\n    const fs = state.size * scale;\n    const k = touchDevice && fs < 16 ? fs / 16 : 1;\n    ta.style.transformOrigin = '0 0';\n    ta.style.transform = k < 1 ? `scale(${k})` : '';\n    ta.style.left = state.x * scale + 'px';\n    ta.style.top = state.y * scale + 'px';\n    ta.style.width = state.w * scale / k + 'px';\n    ta.style.fontSize = fs / k + 'px';\n    ta.style.height = '0px';\n    ta.style.height = Math.max(ta.scrollHeight, state.size * 1.5 * scale / k) + 'px';''',\n'''    ta.style.left = state.x * scale + 'px';\n    ta.style.top = state.y * scale + 'px';\n    ta.style.width = state.w * scale + 'px';\n    ta.style.fontSize = state.size * scale + 'px';\n    ta.style.height = '0px';\n    ta.style.height = Math.max(ta.scrollHeight, state.size * 1.5 * scale) + 'px';''', pg)\npg = rep(\"b.classList.toggle('live', !touchDevice && (pointerInside || stage === document.activeElement) && b.dataset.tool === liveTool);\",\n         \"b.classList.toggle('live', (pointerInside || stage === document.activeElement) && b.dataset.tool === liveTool);\", pg)\npg = rep(\"if (state.mode === 'idle' && pointerInside && !touchDevice) updateHover(lastPt);\",\n         \"if (state.mode === 'idle' && pointerInside) updateHover(lastPt);\", pg)\nassert \"touchDevice\" not in pg, re.findall(r\".*touchDevice.*\", pg)\npg = rep('''  // Grayscale + pixelate, block = max(max(w, h) / 40, 10pt), like the app's CIPhotoEffectMono + CIPixellate\n  function blurTile(r, useCache) {\n    const key = [r.x, r.y, r.w, r.h].map((v) => v.toFixed(1)).join(',');\n    if (useCache && blurCache.has(key)) return blurCache.get(key);\n    const b = Math.max(Math.max(r.w, r.h) / 40, 10);\n    const nx = Math.max(1, Math.ceil(r.w / b)), ny = Math.max(1, Math.ceil(r.h / b));\n    const t = document.createElement('canvas');\n    t.width = nx; t.height = ny;\n    const tc = t.getContext('2d', { willReadFrequently: true });\n    tc.imageSmoothingEnabled = false; // one sample per block center, like CIPixellate\n    const sw = Math.min(nx * b, W - r.x), sh = Math.min(ny * b, H - r.y);\n    tc.drawImage(img, r.x * PX, r.y * PX, sw * PX, sh * PX, 0, 0, nx * sw / (nx * b), ny * sh / (ny * b));\n    try {\n      const d = tc.getImageData(0, 0, nx, ny), p = d.data;\n      for (let i = 0; i < p.length; i += 4) {\n        const y = .299 * p[i] + .587 * p[i + 1] + .114 * p[i + 2];\n        p[i] = p[i + 1] = p[i + 2] = y;\n      }\n      tc.putImageData(d, 0, 0);\n    } catch (e) { /* tainted canvas (file://): keep color */ }\n    const tile = { canvas: t, b, nx, ny };''',\n'''  // Skryn's blur with the app's block size: max(max(w, h) / 40, 10pt)\n  function blurTile(r, useCache) {\n    const key = [r.x, r.y, r.w, r.h].map((v) => v.toFixed(1)).join(',');\n    if (useCache && blurCache.has(key)) return blurCache.get(key);\n    const b = Math.max(Math.max(r.w, r.h) / 40, 10);\n    const { canvas, nx, ny } = mosaic(img, r.x * PX, r.y * PX, r.w * PX, r.h * PX, b * PX);\n    const tile = { canvas, b, nx, ny };''', pg)\n\n# --- assemble: one entry point, named init functions, shared helpers ---\nmarks = dedent(marks, 4)\ndemo = dedent(demo, 4)\npg = dedent(pg, 2)\npg_doc = \"// Playground: a browser replica of Skryn's AnnotationView.\\n// Annotations live in screenshot points (872×543); the image is 2× that.\"\nassert pg_doc in script\n\nnav = '''const bar = document.querySelector('.top');\nconst onScroll = () => bar.classList.toggle('scrolled', scrollY > 8);\naddEventListener('scroll', onScroll, { passive: true });\nonScroll();'''\n\nhelpers = '''// Laptops (mouse or trackpad) get the live playground; phones and tablets get the video\nconst FINE_POINTER = matchMedia('(hover: hover) and (pointer: fine)').matches;\n\ninitNav();\ninitMarks();\ninitDemo();\ninitPlayground();\n\n// Skryn's blur (the app's CIPhotoEffectMono + CIPixellate): square blocks, one sample at each block's center, mixed toward gray.\n// Shrinks the (sx, sy, sw, sh) region of src to one pixel per block; draw the result back up with smoothing off.\nfunction mosaic(src, sx, sy, sw, sh, block, gray = 1) {\n  const nx = Math.max(1, Math.ceil(sw / block)), ny = Math.max(1, Math.ceil(sh / block));\n  // keep the source rect inside the image: the last row and column of blocks sample only what's there\n  const cw = Math.min(nx * block, (src.naturalWidth || src.width) - sx);\n  const ch = Math.min(ny * block, (src.naturalHeight || src.height) - sy);\n  const canvas = document.createElement('canvas');\n  canvas.width = nx; canvas.height = ny;\n  const c = canvas.getContext('2d', { willReadFrequently: true });\n  c.imageSmoothingEnabled = false;\n  c.drawImage(src, sx, sy, cw, ch, 0, 0, cw / block, ch / block);\n  if (gray > 0) {\n    try {\n      const d = c.getImageData(0, 0, nx, ny), q = d.data;\n      for (let i = 0; i < q.length; i += 4) {\n        const l = .299 * q[i] + .587 * q[i + 1] + .114 * q[i + 2];\n        q[i] += (l - q[i]) * gray; q[i + 1] += (l - q[i + 1]) * gray; q[i + 2] += (l - q[i + 2]) * gray;\n      }\n      c.putImageData(d, 0, 0);\n    } catch (e) { /* tainted canvas (file://): keep color */ }\n  }\n  return { canvas, nx, ny };\n}'''\n\nparts = [\n    helpers,\n    \"// Nav: a hairline under the pinned bar once the page scrolls\\nfunction initNav() {\\n\" + indent(nav, 2) + \"\\n}\",\n    \"// The page's own marks: an SVG layer per [data-ink] block, drawn from the [data-mark] elements in it\\nfunction initMarks() {\\n\" + indent(marks, 2) + \"\\n}\",\n    \"// Demo: the playground behind Skryn's blur on a laptop, the video everywhere else\\nfunction initDemo() {\\n\" + indent(demo, 2) + \"\\n}\",\n    pg_doc + \"\\nfunction initPlayground() {\\n\" + indent(pg, 2) + \"\\n}\",\n]\nnew_script = \"  <script>\\n  (() => {\\n\" + indent(\"\\n\\n\".join(parts), 4) + \"\\n  })();\\n\"\ns = s[:a] + new_script + s[z:]\nopen(p, \"w\").write(s)\nprint(\"ok\", len(s))\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"6b25d7e3-789f-4d9b-ad54-f24e457a4018","session_id":"71183914-e83d-4503-afe0-4d46d21c5038","userType":"external","entrypoint":"cli","cwd":"/Users/rsedykh/GitHub/skryn","sessionId":"71183914-e83d-4503-afe0-4d46d21c5038","version":"2.1.286","gitBranch":"main"}
